# Copiar a .env.jenkins (NO se sube al repositorio) y completar.
# scripts/jenkins-up crea .env.jenkins a partir de este archivo si no existe.

# Contraseña del usuario "admin" de Jenkins (jenkins-up genera una si está vacía)
JENKINS_ADMIN_PASSWORD=

# Token de Snyk: https://app.snyk.io/account (Account settings > Auth Token)
SNYK_TOKEN=

# GitHub Container Registry: usuario de GitHub y Personal Access Token con
# permiso write:packages. Solo hacen falta si el pipeline publica la imagen
# (parámetro PUBLISH_IMAGE=true).
GHCR_USER=
GHCR_TOKEN=

# Repositorio que clona el pipeline. Mientras la rama no esté en GitHub se usa
# el repo local montado en /repo (solo cambios con commit).
# Para usar GitHub: REPO_URL=https://github.com/SantMacedonio/DevOps1.git
REPO_URL=file:///repo
REPO_BRANCH=*/feature/contenedores-monitoreo-seguridad
