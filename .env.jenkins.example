# Copiar a .env.jenkins (NO se sube al repositorio) y completar.
# scripts/jenkins-up crea .env.jenkins a partir de este archivo si no existe.

# Contraseña del usuario "admin" de Jenkins (jenkins-up genera una si está vacía)
JENKINS_ADMIN_PASSWORD=

# Token de Snyk: https://app.snyk.io/account (Account settings > Auth Token)
SNYK_TOKEN=

# GitHub Container Registry: usuario de GitHub y Personal Access Token con
# permiso write:packages. Hacen falta para los builds de "main" (siempre
# publican) o si se marca PUBLISH_IMAGE en una rama feature/*.
GHCR_USER=
GHCR_TOKEN=

# Repositorio del job Multibranch. Jenkins descubre solo las ramas "main"
# (despliega en prod) y "feature/*" (despliega en dev).
#   GitHub:     REPO_URL=https://github.com/SantMacedonio/DevOps1.git  (ve lo que tiene push)
#   Sin GitHub: REPO_URL=file:///repo  (el repo local montado; ve lo que tiene commit)
REPO_URL=https://github.com/SantMacedonio/DevOps1.git
