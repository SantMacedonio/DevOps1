          },
          "expr": "sum(rate(http_request_duration_seconds_sum{job=\"shape-game\", route!~\"/healthz|/readyz\"}[$__rate_interval])) / sum(rate(http_request_duration_seconds_count{job=\"shape-game\", route!~\"/healthz|/readyz\"}[$__rate_interval]))",
          "instant": true,
          "legendFormat": "avg",
          "range": false,
