        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"shape-game\", route!~\"/healthz|/readyz\"}[$__rate_interval]))",
          "instant": true,
          "legendFormat": "RPS",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Peticiones por segundo",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Tiempo medio de respuesta de todas las peticiones (sin probes).",
