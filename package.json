{
  "name": "k8s-shape-popper",
  "version": "1.0.0",
  "description": "Incremental Geometry Shape Popper Game with Blue/Green Kubernetes Deployment",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-force-exit \"tests/**/*.test.js\"",
    "pretest:ci": "node -e \"require('fs').mkdirSync('reports/tests',{recursive:true})\"",
    "test:ci": "node --test --test-force-exit --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/tests/junit.xml \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "express": "^4.22.3",
    "helmet": "8.3.0",
    "ioredis": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "",
  "license": "MIT"
}
